{
  "name": "donkey-billabong-dj",
  "productName": "Donkey Billabong DJ",
  "version": "0.1.2",
  "private": true,
  "description": "Cross-platform two-deck DJ application with first-class hardware controller support.",
  "author": "Ben Alembick",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"npm:dev:electron\"",
    "dev:electron": "node scripts/build-electron.mjs && wait-on tcp:127.0.0.1:5173 && cross-env DBDJ_DEV_SERVER=http://127.0.0.1:5173 node scripts/run-electron.mjs",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "node scripts/run-electron.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:test-matrix": "node scripts/generate-test-matrix.mjs",
    "smoke": "npm run build && cross-env DBDJ_SMOKE_TEST=1 node scripts/run-electron.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "music-metadata": "^11.16.1",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.donkeybillabong.dj",
    "productName": "Donkey Billabong DJ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "dist-electron/**",
      "!dist-electron/**/*.map",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Used only if you choose to record from an audio input."
      },
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**"
      ],
      "x64ArchFiles": "**/onnxruntime-node/bin/**"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DonkeyBillabongDJ-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "benalembick",
        "repo": "DonkeyBillabongDJ",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "artifactName": "DonkeyBillabongDJ-macOS.${ext}"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benalembick/DonkeyBillabongDJ.git"
  }
}
