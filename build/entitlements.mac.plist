<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- electron-builder's defaults (V8 JIT; native modules such as onnxruntime-node). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for ad-hoc signing with the hardened runtime (Electron's frameworks carry another Team ID). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The Lighting microphone source. Without it the hardened runtime blocks the microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
